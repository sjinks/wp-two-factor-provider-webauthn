    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jquery": "^4.0.1",
    "@types/jqueryui": "^1.12.24",
    "@types/node": "^26.6.5",
    "@wordpress/babel-plugin-makepot": "^7.0.0",
    "@wordpress/i18n": "^7.0.0",
    "@wwa/rollup-plugin-terser": "^1.1.2",
