{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>sjinks/.github:renovate-config"
  ],
  "packageRules": [
    {
      "description": "Hold i18n-command updates until compatible stable WP-CLI releases exist",
      "matchManagers": [
        "composer"
      ],
      "matchPackageNames": [
        "wp-cli/i18n-command"
      ],
      "allowedVersions": "<2.7.1"
    }
  ]
}
