{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>sjinks/.github:renovate-config"
  ],
  "packageRules": [
    {
      "description": "Hold i18n-command 2.7.1+ until a compatible WP-CLI 2.13 is released",
      "matchManagers": [
        "composer"
      ],
      "matchPackageNames": [
        "wp-cli/i18n-command"
      ],
      "allowedVersions": "<2.7.1 || >=3.0.0"
    }
  ]
}
